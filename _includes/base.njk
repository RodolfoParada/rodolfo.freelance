<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#FF5F01">
  {#- SEO: seoTitle manda; si no, el título lleva la marca solo cuando es corto (Google corta cerca de 60 caracteres). -#}
  {%- set pageTitle = seoTitle if seoTitle else (title if (title | length) > 45 else title + " | " + site.name) -%}
  {%- if pagination and pagination.pageNumber > 0 %}{% set pageTitle = pageTitle + " – Página " + (pagination.pageNumber + 1) %}{% endif -%}
  {%- set pageUrl = site.url + page.url %}
  <title>{{ pageTitle }}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  <link rel="canonical" href="{{ pageUrl }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="es_CL">
  <meta property="og:title" content="{{ pageTitle }}">
  {% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:image" content="{{ site.url }}{{ site.ogImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  {% if description %}<meta name="twitter:description" content="{{ description }}">{% endif %}
  <meta name="twitter:image" content="{{ site.url }}{{ site.ogImage }}">
  {#- Medición obligatoria en todas las páginas (SPEC.md §4): GTM (y GA4 dentro de GTM) y Microsoft Clarity. Mismo orden que index.html. #}
  <script src="/js/trusted-types.js"></script>
  <script src="/js/gtm.js"></script>
  <script src="/js/theme.js"></script>
  <script src="/js/clarity.js" defer></script>
  <script src="/js/core/kit.js" defer></script>
  <script src="/js/components/site-header.js" defer></script>
  <script src="/js/components/site-footer.js" defer></script>
  <script src="/js/components/pagination-nav.js" defer></script>
  <script src="/js/main.min.js" defer></script>
  <link rel="icon" href="/assets/icons/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/assets/fonts/plus-jakarta-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/app.css">
  {%- if tabImage and pagination and pagination.pageNumber == 0 %}
  <link rel="preload" as="image" href="{{ tabImage }}" fetchpriority="high">
  {%- endif %}
</head>
<body>
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WLCDS32G" height="0" width="0" hidden></iframe></noscript>
  <a class="skip-link" href="#main">Saltar al contenido</a>

  <site-header>{% include "partials/site-header.njk" %}</site-header>

  <main id="main">
    {{ content | safe }}
  </main>

  <site-footer>{% include "partials/site-footer.njk" %}</site-footer>
</body>
</html>
