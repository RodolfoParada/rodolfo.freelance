{
  "name": "rodolfo-freelance",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio web de Rodolfo-Freelance: frontend HTML/CSS/JS y API Express para el formulario de contacto vía Gmail.",
  "type": "commonjs",
  "main": "server/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "node scripts/build-css.js",
    "build:js": "node scripts/build-js.js",
    "start": "npm run build && node server/index.js",
    "dev": "npm run build && node --watch server/index.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "nodemailer": "^6.9.13",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "terser": "^5.51.2"
  }
}
