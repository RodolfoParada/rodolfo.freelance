# =============================================================================
# Rodolfo-Freelance — Variables de entorno
# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" al repositorio.
# =============================================================================

# --- Servidor ---
# Puerto donde escucha la aplicación
PORT=3000
# "development" o "production"
NODE_ENV=development

# --- Gmail (envío del formulario de contacto) ---
# Cuenta de Gmail que envía el correo.
GMAIL_USER=tu-correo@gmail.com
# Contraseña de aplicación de Gmail (NO la contraseña normal).
# Genera una en: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Nombre visible del remitente
MAIL_FROM_NAME=Rodolfo-Freelance
# Destinatario que recibe los mensajes del formulario (por defecto = GMAIL_USER)
MAIL_TO=tu-correo@gmail.com

# --- Seguridad ---
# Orígenes permitidos para peticiones al API (separados por coma).
# En producción pon tu dominio real, p. ej. https://rodolfo-freelance.com
ALLOWED_ORIGINS=http://localhost:3000
